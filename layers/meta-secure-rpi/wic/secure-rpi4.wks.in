part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4096 --size 128
part / --source rawcopy --ondisk mmcblk0 --fstype=ext4 --label root --align 4096 --sourceparams="file=${IMGDEPLOYDIR}/${DM_VERITY_IMAGE}-${MACHINE}.${DM_VERITY_IMAGE_TYPE}.verity"
part /crypted --ondisk mmcblk0 --fstype=ext4 --label crypted --align 4096 --size 512 --mkfs-extraopts="-O encrypt"
bootloader --timeout=5                   
